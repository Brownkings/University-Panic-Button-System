# UPBS Environment Configuration Example
# Copy this file to .env or add these variables in your Render Dashboard

DEBUG=False
SECRET_KEY=generate-a-secure-random-secret-key-here

# Allowed Hosts & Domains (Already pre-configured in settings.py for youthalliance.co.za and onrender.com)
# ADDITIONAL_HOSTS=custom.domain.com

# Database Configuration:
# For Local Development (SQLite):
# DATABASE_URL=sqlite:///db.sqlite3
# For Supabase PostgreSQL (Replace with your Supabase Project connection string):
# Note: Use Direct connection (port 5432) or Session Pooler (port 5432)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# SMS Gateway Integration (Twilio / Africa's Talking)
SMS_GATEWAY_PROVIDER=MOCK
SMS_API_KEY=your_sms_api_key_here
SMS_SENDER_ID=UPBS_ALERT

# Geolocation Defaults (Campus Coordinates)
CAMPUS_DEFAULT_LAT=-28.742050
CAMPUS_DEFAULT_LNG=24.765100
