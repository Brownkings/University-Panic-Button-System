# UPBS Environment Configuration Example
# Copy this file to .env and configure for production

DEBUG=False
SECRET_KEY=generate-a-secure-random-secret-key-here
ALLOWED_HOSTS=localhost,127.0.0.1,campus-safety.spu.ac.za

# Database Configuration (Defaults to SQLite for local development)
DATABASE_URL=sqlite:///db.sqlite3
# For Production PostgreSQL:
# DATABASE_URL=postgres://upbs_user:securepassword@localhost:5432/upbs_db

# SMS Gateway Integration (Twilio / Africa's Talking)
SMS_GATEWAY_PROVIDER=MOCK
SMS_API_KEY=your_sms_api_key_here
SMS_SENDER_ID=UPBS_ALERT

# Geolocation Defaults (Campus Coordinates)
CAMPUS_DEFAULT_LAT=-28.742050
CAMPUS_DEFAULT_LNG=24.765100
